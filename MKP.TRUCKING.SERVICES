<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MKP Trucking Service - Professional Transportation & Logistics Portal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mkpRed: '#dc2626',
                        mkpDarkRed: '#991b1b',
                        mkpBlue: '#1e3a8a',
                        mkpOrange: '#f97316',
                        mkpDark: '#0f172a'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        /* Custom Dot Grid Pattern */
        .bg-dots {
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 20px 20px;
        }
        /* Custom Geometric Polygon Clip-paths */
        .clip-triangle-1 {
            clip-path: polygon(0 0, 100% 0, 0 100%);
        }
        .clip-triangle-2 {
            clip-path: polygon(100% 0, 100% 100%, 0 100%);
        }
        /* Tab Transition Animations */
        @keyframes fadeInSlide {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .tab-animate {
            animation: fadeInSlide 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased selection:bg-mkpRed selection:text-white">

    <!-- Notification Toast Box -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 border-l-4 border-mkpRed">
        <i id="toastIcon" class="fa-solid fa-circle-check text-mkpRed text-xl"></i>
        <div>
            <h4 id="toastTitle" class="font-bold text-sm">System Notice</h4>
            <p id="toastMsg" class="text-xs text-slate-300">Your action was completed successfully.</p>
        </div>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md shadow-sm border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo -->
            <a href="#" class="flex items-center space-x-3 group">
                <div class="w-12 h-12 bg-gradient-to-tr from-mkpRed to-mkpDarkRed rounded-xl flex items-center justify-center text-white shadow-md group-hover:scale-105 transition">
                    <i class="fa-solid fa-truck-moving text-2xl"></i>
                </div>
                <div>
                    <span class="text-xl font-extrabold tracking-tight text-slate-900">MKP <span class="text-mkpRed">TRUCKING</span></span>
                    <span class="block text-[10px] tracking-widest font-semibold uppercase text-slate-500">Service & Logistics</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="hidden lg:flex items-center space-x-8 font-medium text-sm text-slate-600">
                <a href="#home" class="hover:text-mkpRed transition">Home</a>
                <a href="#about" class="hover:text-mkpRed transition">About Us</a>
                <a href="#services" class="hover:text-mkpRed transition">Services</a>
                <a href="#features" class="hover:text-mkpRed transition">System Portals</a>
                <a href="#why-us" class="hover:text-mkpRed transition">Why Choose Us</a>
                <a href="#contact" class="hover:text-mkpRed transition">Contact Us</a>
            </nav>

            <!-- CTA Buttons -->
            <div class="hidden md:flex items-center space-x-3">
                <a href="#features" class="bg-mkpRed hover:bg-red-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm shadow-lg shadow-red-500/20 transition flex items-center space-x-2">
                    <i class="fa-solid fa-calculator"></i>
                    <span>Instant Booking</span>
                </a>
            </div>

            <!-- Mobile Menu Button -->
            <button id="menuBtn" class="lg:hidden text-slate-700 focus:outline-none p-2">
                <i class="fa-solid fa-bars text-2xl"></i>
            </button>
        </div>

        <!-- Mobile Menu Dropdown -->
        <div id="mobileMenu" class="hidden lg:hidden bg-white border-b border-slate-200 px-6 py-4 space-y-3 shadow-xl">
            <a href="#home" class="block text-slate-700 font-medium py-1 hover:text-mkpRed">Home</a>
            <a href="#about" class="block text-slate-700 font-medium py-1 hover:text-mkpRed">About Us</a>
            <a href="#services" class="block text-slate-700 font-medium py-1 hover:text-mkpRed">Services</a>
            <a href="#features" class="block text-slate-700 font-medium py-1 hover:text-mkpRed">System Portals</a>
            <a href="#why-us" class="block text-slate-700 font-medium py-1 hover:text-mkpRed">Why Choose Us</a>
            <a href="#contact" class="block text-slate-700 font-medium py-1 hover:text-mkpRed">Contact Us</a>
            <div class="pt-2 border-t border-slate-100 flex flex-col space-y-2">
                <a href="#features" class="bg-mkpRed text-white text-center py-2.5 rounded-xl font-semibold shadow">Instant Booking Portal</a>
            </div>
        </div>
    </header>

    <!-- Poster / Brochure Cover Hero Section -->
    <section id="home" class="relative bg-white py-16 lg:py-28 overflow-hidden bg-dots border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <!-- Poster Box Container -->
            <div class="relative bg-white/90 backdrop-blur-md rounded-3xl shadow-2xl border border-slate-200/80 overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[600px] items-center">
                
                <!-- Background Fleet Truck Overlay -->
                <div class="absolute inset-0 z-0 opacity-20 pointer-events-none flex items-center justify-end overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1586191306917-744007b8979c?auto=format&fit=crop&w=1200&q=80" 
                         onerror="this.src='https://placehold.co/1200x800/e2e8f0/475569?text=MKP+Fleet+Trucks'" 
                         alt="MKP White Fleet Trucks" 
                         class="w-full h-full object-cover mix-blend-multiply">
                </div>

                <!-- Left Geometric Red & Grey Overlays -->
                <div class="lg:col-span-6 relative h-full min-h-[400px] lg:min-h-[550px] flex items-center justify-center p-6 overflow-hidden">
                    <div class="absolute top-0 left-0 w-72 h-72 bg-mkpRed opacity-90 clip-triangle-1 transform -rotate-12 scale-110 shadow-2xl"></div>
                    <div class="absolute bottom-4 left-8 w-64 h-64 bg-slate-900 opacity-85 clip-triangle-2 transform rotate-45 shadow-xl"></div>
                    <div class="absolute top-20 left-24 w-48 h-48 bg-red-700 opacity-95 clip-triangle-1 transform rotate-12"></div>
                    
                    <!-- Embedded Fleet Truck Photo -->
                    <div class="relative z-10 w-full max-w-md h-72 sm:h-80 rounded-2xl overflow-hidden shadow-2xl border-4 border-white transform -rotate-2 hover:rotate-0 transition duration-500">
                        <img src="https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=800&q=80" 
                             onerror="this.src='https://placehold.co/800x600/cbd5e1/1e293b?text=MKP+Truck+Highway'" 
                             alt="Truck on Highway" 
                             class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent flex items-end p-4">
                            <span class="text-white text-xs font-bold bg-mkpRed/90 px-3 py-1 rounded-full shadow-lg">
                                <i class="fa-solid fa-truck-ramp-box mr-1"></i> Hydraulic Lifter Equipped
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Right Content Typography Section -->
                <div class="lg:col-span-6 p-8 lg:p-12 space-y-6 relative z-10 text-center lg:text-left">
                    <div class="inline-flex items-center space-x-2 bg-red-100 text-mkpRed px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>MKP Trucking Service Portfolio</span>
                    </div>

                    <div class="space-y-2">
                        <h1 class="text-4xl sm:text-6xl font-black tracking-tighter text-slate-900 uppercase drop-shadow-sm">
                            MKP <span class="text-mkpRed">TRANSPORT</span>
                        </h1>
                        <p class="text-xs sm:text-sm font-extrabold tracking-widest text-slate-700 uppercase">
                            Trucking & Logistics Service Provider
                        </p>
                    </div>

                    <p class="text-base sm:text-lg font-semibold text-slate-600 leading-snug">
                        "Reliable Transportation. Safe Handling. Seamless Delivery."
                    </p>

                    <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
                        Pioneering simple, complete, and specialized moving services for residential relocation, condominium moving, office transfers, warehouse inventory, and commercial goods delivery.
                    </p>

                    <!-- Contact Numbers Box -->
                    <div class="bg-slate-900 text-white p-5 rounded-2xl shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4 border-l-4 border-mkpRed">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-mkpRed rounded-xl flex items-center justify-center text-white">
                                <i class="fa-solid fa-phone-volume text-lg"></i>
                            </div>
                            <div>
                                <span class="text-[10px] uppercase font-bold text-slate-400 block">Direct Hotline Numbers</span>
                                <div class="text-sm sm:text-base font-extrabold tracking-wide">
                                    <a href="tel:09303076342" class="hover:text-red-400 transition">0930 307 6342</a> / 
                                    <a href="tel:09075478946" class="hover:text-red-400 transition">0907 547 8946</a>
                                </div>
                            </div>
                        </div>
                        <a href="#features" class="bg-mkpRed hover:bg-red-700 text-white px-5 py-2.5 rounded-xl text-xs font-bold transition shadow-md w-full sm:w-auto text-center">
                            Open Portal
                        </a>
                    </div>

                    <div class="flex flex-wrap gap-3 justify-center lg:justify-start pt-2">
                        <a href="#services" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold px-6 py-3 rounded-xl transition shadow">
                            Explore Our Services
                        </a>
                        <a href="#features" class="bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-bold px-6 py-3 rounded-xl transition">
                            Interactive System Portal
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- About Us Section -->
    <section id="about" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-mkpRed uppercase font-bold text-xs tracking-widest bg-red-50 px-3 py-1 rounded-full">About Us</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">MKP TRUCKING SERVICE</h2>
                <div class="w-20 h-1.5 bg-mkpRed mx-auto rounded-full"></div>
                <p class="text-slate-600 text-base">
                    A forward-looking transportation and logistics service provider dedicated to delivering reliable, efficient, and convenient trucking and moving solutions to meet the business and personal needs of individuals, families, businesses, and commercial establishments.
                </p>
            </div>

            <!-- Mission & Vision Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
                <!-- Vision -->
                <div class="bg-slate-50 border border-slate-100 p-8 rounded-3xl shadow-sm hover:shadow-md transition space-y-4">
                    <div class="w-14 h-14 bg-red-100 text-mkpRed rounded-2xl flex items-center justify-center text-2xl font-bold">
                        <i class="fa-solid fa-eye"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900">Our Vision</h3>
                    <p class="text-slate-600 leading-relaxed">
                        To become a trusted and preferred trucking and logistics service provider, recognized for dependable transportation solutions, professional customer service, and a commitment to helping individuals and businesses move their belongings and goods efficiently and securely.
                    </p>
                </div>
                <!-- Mission -->
                <div class="bg-slate-50 border border-slate-100 p-8 rounded-3xl shadow-sm hover:shadow-md transition space-y-4">
                    <div class="w-14 h-14 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-2xl font-bold">
                        <i class="fa-solid fa-bullseye"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-900">Our Mission</h3>
                    <p class="text-slate-600 leading-relaxed">
                        To provide accessible, reliable, and customer-focused trucking services that make residential relocation, commercial moving, and goods transportation more convenient and efficient.
                    </p>
                </div>
            </div>

            <!-- Hydraulic Lifters Highlight -->
            <div class="bg-gradient-to-r from-slate-900 via-red-950 to-slate-900 text-white rounded-3xl p-8 sm:p-12 shadow-xl flex flex-col lg:flex-row items-center justify-between gap-8 border border-red-900/40">
                <div class="space-y-4 max-w-2xl">
                    <div class="inline-flex items-center space-x-2 bg-mkpRed text-white text-xs font-semibold px-3 py-1 rounded-full">
                        <i class="fa-solid fa-bolt"></i> Special Equipment
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-extrabold">Equipped with Hydraulic Lifters for Secure Cargo Handling</h3>
                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                        We take pride in pioneering simple, complete, and specialized moving services through the use of our trucks equipped with hydraulic lifters, designed to make loading, unloading, and transporting goods more efficient, convenient, and secure.
                    </p>
                </div>
                <div class="w-full lg:w-auto flex flex-col sm:flex-row gap-4">
                    <div class="bg-white/10 p-6 rounded-2xl text-center border border-white/10 backdrop-blur-sm">
                        <i class="fa-solid fa-truck-ramp-box text-4xl text-red-500 mb-2"></i>
                        <h4 class="font-bold text-lg">Hydraulic Lift</h4>
                        <p class="text-xs text-slate-300">Heavy Lifting Made Easy</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-20 bg-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-mkpRed uppercase font-bold text-xs tracking-widest bg-red-100 px-3 py-1 rounded-full">Our Services</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900">Comprehensive Trucking & Relocation Solutions</h2>
                <div class="w-20 h-1.5 bg-mkpRed mx-auto rounded-full"></div>
                <p class="text-slate-600">
                    Whether transferring household belongings to a new residence, relocating an entire office, or transporting essential business supplies, we provide tailored transport solutions.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Service 1 -->
                <div class="bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl transition group border border-slate-200/60 flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="w-14 h-14 bg-red-100 text-mkpRed rounded-2xl flex items-center justify-center text-2xl group-hover:bg-mkpRed group-hover:text-white transition">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900">Goods Delivery Services</h3>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                            Dependable transportation for businesses, retailers, suppliers, and commercial clients requiring general goods and merchandise delivery.
                        </p>
                    </div>
                    <div class="pt-6 mt-6 border-t border-slate-100">
                        <a href="#features" class="text-mkpRed font-semibold text-xs sm:text-sm flex items-center justify-between hover:underline">
                            <span>Book Now</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Service 2 -->
                <div class="bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl transition group border border-slate-200/60 flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="w-14 h-14 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-2xl group-hover:bg-mkpRed transition">
                            <i class="fa-solid fa-truck-medical"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900">Medical Supplies Delivery</h3>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                            Specialized transport support for clinics, hospitals, pharmacies, and distributors of appropriately packaged, non-hazardous medical items.
                        </p>
                    </div>
                    <div class="pt-6 mt-6 border-t border-slate-100">
                        <a href="#features" class="text-mkpRed font-semibold text-xs sm:text-sm flex items-center justify-between hover:underline">
                            <span>Book Now</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Service 3 -->
                <div class="bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl transition group border border-slate-200/60 flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="w-14 h-14 bg-red-100 text-mkpRed rounded-2xl flex items-center justify-center text-2xl group-hover:bg-mkpRed group-hover:text-white transition">
                            <i class="fa-solid fa-warehouse"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900">Warehouse Transfer Services</h3>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                            Organized inventory and equipment relocation from one facility to another to minimize operational disruption.
                        </p>
                    </div>
                    <div class="pt-6 mt-6 border-t border-slate-100">
                        <a href="#features" class="text-mkpRed font-semibold text-xs sm:text-sm flex items-center justify-between hover:underline">
                            <span>Book Now</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <!-- Service 4 -->
                <div class="bg-white rounded-3xl p-6 shadow-sm hover:shadow-xl transition group border border-slate-200/60 flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="w-14 h-14 bg-slate-900 text-white rounded-2xl flex items-center justify-center text-2xl group-hover:bg-mkpRed transition">
                            <i class="fa-solid fa-tower-broadcast"></i>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900">Telco Equipment Transport</h3>
                        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
