        </div>
    </section>

    <!-- System Features Section (Customer Portal, Driver App, Admin Dashboard with non-scrolling animated tab switcher) -->
    <section id="features" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
