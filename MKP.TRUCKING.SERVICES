                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Phone Number</label>
                                    <input type="tel" id="clientPhone" required class="w-full text-sm border border-slate-300 rounded-xl p-3.5 bg-slate-50 focus:ring-2 focus:ring-mkpRed focus:outline-none" placeholder="09123456789">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Pickup Location</label>
                                    <input type="text" id="pickupLoc" required class="w-full text-sm border border-slate-300 rounded-xl p-3.5 bg-slate-50 focus:ring-2 focus:ring-mkpRed focus:outline-none" placeholder="e.g. Cainta, Rizal">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Drop-off Location</label>
                                    <input type="text" id="dropoffLoc" required class="w-full text-sm border border-slate-300 rounded-xl p-3.5 bg-slate-50 focus:ring-2 focus:ring-mkpRed focus:outline-none" placeholder="e.g. Pasig City">
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Service / Cargo Type</label>
                                    <select id="serviceType" class="w-full text-sm border border-slate-300 rounded-xl p-3.5 bg-slate-50 focus:ring-2 focus:ring-mkpRed focus:outline-none">
                                        <option value="House Moving">House Moving / Lipat-Bahay</option>
                                        <option value="Office Relocation">Office Relocation</option>
                                        <option value="Condo Relocation">Condominium Relocation</option>
                                        <option value="Goods Delivery">General Goods Delivery</option>
                                        <option value="Medical Supplies">Medical Supplies Delivery</option>
                                        <option value="Warehouse Transfer">Warehouse Transfer</option>
                                        <option value="Telco Equipment">Telco Equipment Transport</option>
                                        <option value="Construction Supplies">Construction Supplies Delivery</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Truck Choice</label>
                                    <select id="truckChoice" class="w-full text-sm border border-slate-300 rounded-xl p-3.5 bg-slate-50 focus:ring-2 focus:ring-mkpRed focus:outline-none">
                                        <option value="L300">L300 Utility Van</option>
                                        <option value="Closed Van" selected>Closed Van (Lipat-Bahay)</option>
                                        <option value="6-Wheeler w/ Lifter">6-Wheeler w/ Hydraulic Lifter</option>
                                        <option value="10-Wheeler Wing Van">10-Wheeler Wing Van</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Additional Notes or Requirements</label>
                                <textarea rows="3" id="clientNotes" class="w-full text-sm border border-slate-300 rounded-xl p-3.5 bg-slate-50 focus:ring-2 focus:ring-mkpRed focus:outline-none" placeholder="List major furniture, items, or special instructions..."></textarea>
                            </div>

                            <button type="submit" class="w-full bg-mkpRed hover:bg-red-700 text-white font-bold py-4 rounded-2xl shadow-xl shadow-red-500/20 transition flex items-center justify-center space-x-2 text-base">
                                <i class="fa-solid fa-paper-plane"></i>
                                <span>Submit Booking Request</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-950 text-white py-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
            <div class="space-y-4 md:col-span-2">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-mkpRed rounded-xl flex items-center justify-center text-white font-bold">
                        <i class="fa-solid fa-truck-moving"></i>
                    </div>
                    <span class="text-lg font-extrabold tracking-tight">MKP TRUCKING SERVICE</span>
                </div>
                <p class="text-xs text-slate-400 max-w-sm leading-relaxed">
                    Moving with Purpose. Delivering with Commitment. Reliable transportation, safe handling, and seamless delivery for all your residential and commercial needs.
                </p>
                <div class="flex space-x-3 pt-2">
                    <a href="#" class="w-9 h-9 bg-slate-800 hover:bg-mkpRed rounded-full flex items-center justify-center text-white transition"><i class="fa-brands fa-facebook-f text-xs"></i></a>
                    <a href="#" class="w-9 h-9 bg-slate-800 hover:bg-mkpRed rounded-full flex items-center justify-center text-white transition"><i class="fa-brands fa-instagram text-xs"></i></a>
                    <a href="#" class="w-9 h-9 bg-slate-800 hover:bg-mkpRed rounded-full flex items-center justify-center text-white transition"><i class="fa-brands fa-twitter text-xs"></i></a>
                </div>
            </div>
            <div>
                <h4 class="font-bold text-sm text-red-500 uppercase tracking-widest mb-4">Quick Links</h4>
                <ul class="space-y-2 text-xs text-slate-400">
                    <li><a href="#home" class="hover:text-white transition">Home</a></li>
                    <li><a href="#about" class="hover:text-white transition">About Us</a></li>
                    <li><a href="#services" class="hover:text-white transition">Services</a></li>
                    <li><a href="#features" class="hover:text-white transition">System Portals</a></li>
                    <li><a href="#contact" class="hover:text-white transition">Contact Us</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-sm text-red-500 uppercase tracking-widest mb-4">Our Offices</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-2">
                    <strong class="text-white block">Main Office:</strong> 492 BKL17 Kabisig San Andress Cainta Rizal
                </p>
                <p class="text-xs text-slate-400 leading-relaxed">
                    <strong class="text-white block">Garage:</strong> No.018 Sampaguita St. Highway 2000 Taytay Rizal
                </p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 border-t border-slate-900 text-center text-xs text-slate-500">
            &copy; 2026 MKP Trucking Service. All rights reserved. Designed for reliable logistics and professional transport.
        </div>
    </footer>

    <!-- JavaScript Interactions -->
    <script>
        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Feature Tabs Switcher (Zero Page Scroll/Jump with Smooth Animation)
        function switchTab(tabName) {
            const tabs = ['customer', 'driver', 'admin'];
            tabs.forEach(t => {
                const pane = document.getElementById(`tab-${t}`);
                const btn = document.getElementById(`btn-${t}`);
                if (t === tabName) {
                    pane.classList.remove('hidden');
                    // Re-trigger animation
                    pane.classList.remove('tab-animate');
                    void pane.offsetWidth; // trigger reflow
                    pane.classList.add('tab-animate');

                    btn.className = "tab-btn px-6 py-3 rounded-2xl font-bold text-sm bg-slate-900 text-white shadow-lg transition flex items-center space-x-2";
                } else {
                    pane.classList.add('hidden');
                    btn.className = "tab-btn px-6 py-3 rounded-2xl font-bold text-sm bg-slate-100 text-slate-700 hover:bg-slate-200 transition flex items-center space-x-2";
                }
            });
        }

        // Price Estimator Logic
        function calculatePrice() {
            const truckBase = parseFloat(document.getElementById('calcTruck').value);
            const km = parseFloat(document.getElementById('calcKm').value) || 10;
            const perKmRate = 75; // ₱75 per km
            const total = truckBase + (km * perKmRate);
            document.getElementById('calcTotal').innerText = '₱' + total.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            showToast('Quotation Calculator', 'Estimated cost calculated successfully!');
        }

        // Toast Notification System
        function showToast(title, msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastTitle').innerText = title;
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 4000);
        }

        // Booking Form Submission Handler
        function handleBookingSubmit(event) {
            event.preventDefault();
            const name = document.getElementById('clientName').value;
            const service = document.getElementById('serviceType').value;
            const truck = document.getElementById('truckChoice').value;

            showToast('Booking Successful!', `Thank you, ${name}! Your booking request for ${service} (${truck}) has been received. Our team will contact you shortly.`);
            document.getElementById('bookingForm').reset();
        }
    </script>
</body>
</html>
