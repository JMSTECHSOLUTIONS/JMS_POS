                            <i class="fa-solid fa-file-invoice-dollar text-mkpRed"></i>
                            <span>Instant Booking Request Form</span>
                        </h3>
                        <form id="bookingForm" onsubmit="handleBookingSubmit(event)" class="space-y-6">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Client Name</label>
                                    <input type="text" id="clientName" required class="w-full text-sm border border-slate-300 rounded-xl p-3.5 bg-slate-50 focus:ring-2 focus:ring-mkpRed focus:outline-none" placeholder="John Doe">
